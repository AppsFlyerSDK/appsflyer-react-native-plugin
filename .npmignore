# Everything below is dev/internal tooling, docs, or generated output that the plugin does not
# need at consume-time (index.ts + src/ + PurchaseConnector/ + ios/*.{h,m,mm,swift} + android/
# build.gradle + android/src/main + expo/ + app.plugin.js + the podspec + react-native.config.js
# are NOT listed here on purpose — npm ships everything not matched below).

# AI tooling / internal project instructions
.claude/
CLAUDE.md
.mcp.json

# Dev tooling & config, not needed by consumers
.github/
.vscode/
.specify/
.reviews/
.af-e2e/
.af-smoke/
Makefile
doctor.config.json
eslint.config.cjs
babel.config.js
jest.config.js
tsconfig.json
package-lock.json

# Tests and generated coverage
__tests__/
coverage/

# Examples and demo apps
example/
demos/

# Internal planning docs, schemas, and one-off scripts — not part of the published API
Docs/
specs/
schemas/
scripts/
RELEASE_USER_MANUAL.md

# Native build artifacts / IDE state — regenerated by the consumer's own build, never shipped
android/build/
android/.gradle/
android/.idea/
android/.settings/
android/.project
android/local.properties
android/src/test/
ios/*.xcodeproj/

# OS junk
.DS_Store
**/.DS_Store
